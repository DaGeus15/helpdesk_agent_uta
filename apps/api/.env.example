# Servidor
PORT=3000
NODE_ENV=development

# Telegram
TELEGRAM_BOT_TOKEN=
# polling (local) | webhook (producción)
TELEGRAM_MODE=polling
# Requerido solo si TELEGRAM_MODE=webhook
TELEGRAM_WEBHOOK_SECRET=
# URL pública HTTPS de la API (requerida en modo webhook)
PUBLIC_API_URL=

# LLM (Gemini por defecto). GEMINI_MODEL admite una cadena separada por comas: si un modelo agota su cuota (429) se usa el siguiente.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash,gemini-2.5-flash-lite,gemini-2.0-flash

# Supabase (service role: solo en la API, nunca en el dashboard)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# CORS del dashboard (lista separada por comas)
DASHBOARD_ORIGIN=http://localhost:5173

# Contexto del agente
CONTEXT_WINDOW_MESSAGES=12
SUMMARY_EVERY_N_MESSAGES=8
